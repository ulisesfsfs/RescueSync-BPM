        <elements xmi:type="process:ServiceTask" xmi:id="_PhoYMKvUEfGGjYEUN-iB-A" name="Liberar ofertas no seleccionadas" outgoing="_LzP8IN0PEfGInux_mhtkUQ" incoming="_gd8UALjoEfGlPdn3R72URQ">
          <dynamicLabel xmi:type="expression:Expression" xmi:id="_Pho_QavUEfGGjYEUN-iB-A" name="" content="" returnTypeFixed="true"/>
