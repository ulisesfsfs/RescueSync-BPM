                  <referencedElements xmi:type="parameter:Parameter" xmi:id="_TOMeQd7REfGiM620Hq_yEw" name="snClientId" typeClassname="java.lang.String"/>
                  <referencedElements xmi:type="parameter:Parameter" xmi:id="_TOMeQt7REfGiM620Hq_yEw" name="urlSistemaNacional" typeClassname="java.lang.String"/>
                  <referencedElements xmi:type="process:Data" xmi:id="_TOMeQ97REfGiM620Hq_yEw" name="emergenciaId" dataType="_PcgnpKvUEfGGjYEUN-iB-A"/>
                  <referencedElements xmi:type="parameter:Parameter" xmi:id="_TOMeRN7REfGiM620Hq_yEw" name="snClientSecret" typeClassname="java.lang.String"/>
                </expression>
