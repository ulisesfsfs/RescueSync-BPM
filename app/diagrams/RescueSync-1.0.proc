          <connectors xmi:type="process:Connector" xmi:id="_6DB9sN7NEfGiM620Hq_yEw" name="Liberar compromisos de ONG no seleccionadas" definitionId="scripting-groovy-script" event="ON_ENTER" definitionVersion="1.0.1">
            <configuration xmi:type="connectorconfiguration:ConnectorConfiguration" xmi:id="_6DB9sd7NEfGiM620Hq_yEw" definitionId="scripting-groovy-script" version="1.0.1" modelVersion="9">
              <parameters xmi:type="connectorconfiguration:ConnectorParameter" xmi:id="_6DB9st7NEfGiM620Hq_yEw" key="script">
                <expression xmi:type="expression:Expression" xmi:id="_6DB9s97NEfGiM620Hq_yEw" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnTypeFixed="true"/>
              </parameters>
              <parameters xmi:type="connectorconfiguration:ConnectorParameter" xmi:id="_6DB9tN7NEfGiM620Hq_yEw" key="variables">
                <expression xmi:type="expression:Expression" xmi:id="_6DB9td7NEfGiM620Hq_yEw" returnType="java.util.List" returnTypeFixed="true"/>
              </parameters>
              <parameters xmi:type="connectorconfiguration:ConnectorParameter" xmi:id="_6DB9tt7NEfGiM620Hq_yEw" key="fakeScriptExpression">
                <expression xmi:type="expression:Expression" xmi:id="_6DB9t97NEfGiM620Hq_yEw" name="liberarOngsNoSeleccionadas" content="&#xD;&#xA;import groovy.json.JsonSlurper&#xD;&#xA;import java.net.HttpURLConnection&#xD;&#xA;import java.net.URLEncoder&#xD;&#xA;&#xD;&#xA;// 1. Obtener las ONG no seleccionadas&#xD;&#xA;def identificadores = new JsonSlurper().parseText(&#xD;&#xA;&#x9;ongsNoSeleccionadasJson ?: &quot;[]&quot;&#xD;&#xA;)&#xD;&#xA;&#xD;&#xA;if (!(identificadores instanceof List) ||&#xD;&#xA;&#x9;identificadores.any { !(it instanceof String) || !it.trim() }) {&#xD;&#xA;&#x9;throw new IllegalArgumentException(&#xD;&#xA;&#x9;&#x9;&quot;La lista de ONG no seleccionadas es inválida&quot;&#xD;&#xA;&#x9;)&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Si no hay ONG descartadas, no hay nada que liberar&#xD;&#xA;if (identificadores.isEmpty()) {&#xD;&#xA;&#x9;println &quot;No hay compromisos de ONG para liberar&quot;&#xD;&#xA;&#x9;return 0&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// 2. Autenticación OAuth2 con Sistema Nacional&#xD;&#xA;def formulario = [&#xD;&#xA;&#x9;grant_type: &quot;client_credentials&quot;,&#xD;&#xA;&#x9;client_id: snClientId,&#xD;&#xA;&#x9;client_secret: snClientSecret&#xD;&#xA;].collect { clave, valor ->&#xD;&#xA;&#x9;URLEncoder.encode(clave, &quot;UTF-8&quot;) + &quot;=&quot; +&#xD;&#xA;&#x9;URLEncoder.encode(valor.toString(), &quot;UTF-8&quot;)&#xD;&#xA;}.join(&quot;&amp;&quot;)&#xD;&#xA;&#xD;&#xA;def login = new URL(&#xD;&#xA;&#x9;urlSistemaNacional + &quot;/login&quot;&#xD;&#xA;).openConnection() as HttpURLConnection&#xD;&#xA;&#xD;&#xA;login.requestMethod = &quot;POST&quot;&#xD;&#xA;login.doOutput = true&#xD;&#xA;login.connectTimeout = 10000&#xD;&#xA;login.readTimeout = 90000&#xD;&#xA;login.setRequestProperty(&#xD;&#xA;&#x9;&quot;Content-Type&quot;,&#xD;&#xA;&#x9;&quot;application/x-www-form-urlencoded&quot;&#xD;&#xA;)&#xD;&#xA;&#xD;&#xA;def token&#xD;&#xA;&#xD;&#xA;try {&#xD;&#xA;&#x9;login.outputStream.withWriter(&quot;UTF-8&quot;) {&#xD;&#xA;&#x9;&#x9;it.write(formulario)&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;int codigoLogin = login.responseCode&#xD;&#xA;&#xD;&#xA;&#x9;if (codigoLogin != 200) {&#xD;&#xA;&#x9;&#x9;throw new RuntimeException(&#xD;&#xA;&#x9;&#x9;&#x9;&quot;Falló la autenticación: HTTP ${codigoLogin}&quot;&#xD;&#xA;&#x9;&#x9;)&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;def respuesta = new JsonSlurper().parse(&#xD;&#xA;&#x9;&#x9;login.inputStream, &quot;UTF-8&quot;&#xD;&#xA;&#x9;)&#xD;&#xA;&#xD;&#xA;&#x9;token = respuesta.access_token&#xD;&#xA;&#xD;&#xA;&#x9;if (!token) {&#xD;&#xA;&#x9;&#x9;throw new RuntimeException(&#xD;&#xA;&#x9;&#x9;&#x9;&quot;No se recibió access_token&quot;&#xD;&#xA;&#x9;&#x9;)&#xD;&#xA;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;println &quot;Autenticación con Sistema Nacional exitosa&quot;&#xD;&#xA;&#xD;&#xA;} finally {&#xD;&#xA;&#x9;login.disconnect()&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// 3. Liberar compromisos de cada ONG descartada&#xD;&#xA;def liberadas = 0&#xD;&#xA;def sinCompromisos = 0&#xD;&#xA;&#xD;&#xA;def emergencia = URLEncoder.encode(&#xD;&#xA;&#x9;emergenciaId.toString(), &quot;UTF-8&quot;&#xD;&#xA;)&#xD;&#xA;&#xD;&#xA;identificadores.unique().each { identificador ->&#xD;&#xA;&#xD;&#xA;&#x9;def ong = URLEncoder.encode(&#xD;&#xA;&#x9;&#x9;identificador, &quot;UTF-8&quot;&#xD;&#xA;&#x9;)&#xD;&#xA;&#xD;&#xA;&#x9;def url = urlSistemaNacional +&#xD;&#xA;&#x9;&#x9;&quot;/recursos/compromisos/${emergencia}&quot; +&#xD;&#xA;&#x9;&#x9;&quot;/ongs/${ong}/liberacion&quot;&#xD;&#xA;&#xD;&#xA;&#x9;def conexion = new URL(&#xD;&#xA;&#x9;&#x9;url&#xD;&#xA;&#x9;).openConnection() as HttpURLConnection&#xD;&#xA;&#xD;&#xA;&#x9;conexion.requestMethod = &quot;POST&quot;&#xD;&#xA;&#x9;conexion.connectTimeout = 10000&#xD;&#xA;&#x9;conexion.readTimeout = 90000&#xD;&#xA;&#xD;&#xA;&#x9;conexion.setRequestProperty(&#xD;&#xA;&#x9;&#x9;&quot;Authorization&quot;,&#xD;&#xA;&#x9;&#x9;&quot;Bearer ${token}&quot;&#xD;&#xA;&#x9;)&#xD;&#xA;&#xD;&#xA;&#x9;conexion.setRequestProperty(&#xD;&#xA;&#x9;&#x9;&quot;Accept&quot;,&#xD;&#xA;&#x9;&#x9;&quot;application/json&quot;&#xD;&#xA;&#x9;)&#xD;&#xA;&#xD;&#xA;&#x9;try {&#xD;&#xA;&#x9;&#x9;int codigo = conexion.responseCode&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;if (codigo == 200) {&#xD;&#xA;&#x9;&#x9;&#x9;liberadas++&#xD;&#xA;&#x9;&#x9;&#x9;println &quot;Compromiso liberado para ONG ${identificador}&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;} else if (codigo == 404) {&#xD;&#xA;&#x9;&#x9;&#x9;sinCompromisos++&#xD;&#xA;&#x9;&#x9;&#x9;println &quot;La ONG ${identificador} no tiene compromisos para liberar&quot;&#xD;&#xA;&#xD;&#xA;&#x9;&#x9;} else {&#xD;&#xA;&#x9;&#x9;&#x9;throw new RuntimeException(&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&quot;Error liberando ONG ${identificador}: HTTP ${codigo}&quot;&#xD;&#xA;&#x9;&#x9;&#x9;)&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#xD;&#xA;&#x9;} finally {&#xD;&#xA;&#x9;&#x9;conexion.disconnect()&#xD;&#xA;&#x9;}&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// 4. Resultado final&#xD;&#xA;println &quot;Liberaciones exitosas: ${liberadas}&quot;&#xD;&#xA;println &quot;ONG sin compromisos: ${sinCompromisos}&quot;&#xD;&#xA;&#xD;&#xA;return liberadas&#xD;&#xA;" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnType="java.lang.Object" returnTypeFixed="true">
