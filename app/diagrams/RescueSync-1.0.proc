            <constraints xmi:type="process:ContractConstraint" xmi:id="_oP1WMNR3EfG_kLrQjQqzwA" expression="import groovy.json.JsonSlurper&#xD;&#xA;&#xD;&#xA;if (compromisosInput == null || compromisosInput.trim().isEmpty()) {&#xD;&#xA;    return false&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;try {&#xD;&#xA;    def datos = new JsonSlurper().parseText(compromisosInput)&#xD;&#xA;&#xD;&#xA;    if (!(datos instanceof Map)) {&#xD;&#xA;        return false&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    if (!datos.emergencia_externa_id?.toString()?.trim()) {&#xD;&#xA;        return false&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    if (!(datos.nivel_gravedad in [&#xD;&#xA;        &quot;BAJA&quot;, &quot;MEDIA&quot;, &quot;ALTA&quot;, &quot;CRITICA&quot;,&#xD;&#xA;        &quot;BAJO&quot;, &quot;MEDIO&quot;, &quot;ALTO&quot;, &quot;CRITICO&quot;&#xD;&#xA;    ])) {&#xD;&#xA;        return false&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    if (!(datos.aportes instanceof List) || datos.aportes.isEmpty()) {&#xD;&#xA;        return false&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    def combinaciones = [] as Set&#xD;&#xA;&#xD;&#xA;    for (def aporte : datos.aportes) {&#xD;&#xA;        if (!(aporte instanceof Map)) {&#xD;&#xA;            return false&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        if (!aporte.identificador_nacional?.toString()?.trim()) {&#xD;&#xA;            return false&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        if (!aporte.codigo_recurso?.toString()?.trim()) {&#xD;&#xA;            return false&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        if (!(aporte.cantidad instanceof Integer) || aporte.cantidad &lt;= 0) {&#xD;&#xA;            return false&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        if (!(aporte.tipo_asignacion in [&quot;principal&quot;, &quot;apoyo&quot;])) {&#xD;&#xA;            return false&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        def clave = [&#xD;&#xA;            aporte.identificador_nacional,&#xD;&#xA;            aporte.codigo_recurso&#xD;&#xA;        ]&#xD;&#xA;&#xD;&#xA;        if (!combinaciones.add(clave)) {&#xD;&#xA;            return false&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    return true&#xD;&#xA;} catch (Exception e) {&#xD;&#xA;    return false&#xD;&#xA;}" errorMessage="Los datos de los compromisos son inválidos" name="validarCompromisos">
              <inputNames>compromisosInput</inputNames>
            </constraints>
            <constraints xmi:type="process:ContractConstraint" xmi:id="_2L2lINR3EfG_kLrQjQqzwA" expression="if (adjudicacionIdInput == null) {&#xD;&#xA;    return false&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;def id = adjudicacionIdInput.trim()&#xD;&#xA;&#xD;&#xA;return id ==~ /[1-9][0-9]*/" errorMessage="El identificador de adjudicación es inválido" name="validarAdjudicacionId">
              <inputNames>adjudicacionIdInput</inputNames>
            </constraints>
